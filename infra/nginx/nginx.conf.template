worker_processes auto;

# Master process needs root only to bind the privileged ports below (443,
# 3478/tcp via the stream demux); every actual request is handled by a
# worker running as this unprivileged user.
user nginx;

events {
    worker_connections 1024;
}

# ---- Stream layer: SNI demux on 443 (§7.1) ----
# One TLS-terminating front door on 443. Traffic whose ClientHello SNI matches
# TURN_HOSTNAME is passed raw (still encrypted, undecrypted) to coturn;
# everything else -- including PUBLIC_HOSTNAME, which is what clients dial for
# the app itself and for LiveKit's WSS signaling -- goes to the http block
# below, which does the real TLS termination.
#
# TURN_HOSTNAME and PUBLIC_HOSTNAME must be two different hostnames. If they
# were ever the same, this demux couldn't distinguish "TURN traffic" from "a
# client dialing the app/LiveKit", and app/LiveKit traffic would get routed to
# coturn instead -- which doesn't speak HTTP or WS, so it just resets the
# connection.
#
# Hard constraint (§7.1): every ICE server entry MUST use TURN_HOSTNAME, never
# a bare IP, or this demux has nothing to match on and TURN/TLS silently stops
# working.
stream {
    map $ssl_preread_server_name $upstream {
        "${TURN_HOSTNAME}"        turn_backend;
        default                   app_backend;
    }

    upstream turn_backend {
        server ${TURN_BACKEND_HOST}:5349;   # coturn's TURN/TLS listener (shares
        # this container's network namespace — see docker-compose.yml's
        # `network_mode: service:nginx` on the coturn service). Defaults to
        # 127.0.0.1 in docker-entrypoint.sh; docker-compose.testing.yml
        # overrides this to route through toxiproxy for scripted fault
        # injection (scripts/toxiproxy-scenarios.sh) without this file
        # needing to know that testing exists.
    }

    upstream app_backend {
        server 127.0.0.1:8443; # forwarded into the http block's TLS server below
    }

    server {
        listen 443;
        listen [::]:443;
        proxy_pass $upstream;
        ssl_preread on;
    }
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # Actual TLS termination + app/LiveKit routing lives here, reached only via the
    # stream block's app_backend upstream above (loopback, not exposed directly).
    include /etc/nginx/conf.d/*.conf;
}
