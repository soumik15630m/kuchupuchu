# Reached only via the stream block's app_backend upstream (nginx.conf.template).
# Listens on loopback 8443 — never exposed to the host directly.

# Keyed on IP, applied to every /auth/ endpoint uniformly (M4/M10) rather
# than each endpoint hand-rolling its own limiter -- OTP request/verify and
# quality.py already rate-limit at the app layer; this is the IP-level
# backstop nothing else in the stack provides.
limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=10r/s;

server {
    listen 127.0.0.1:8443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOSTNAME}/privkey.pem;

    # Pinned rather than inheriting the base image's compiled OpenSSL
    # defaults, which vary by image tag/patch level and aren't guaranteed
    # to exclude TLS 1.0/1.1 or weak ciphers. Matches what coturn's own
    # config already does (no-tlsv1/no-tlsv1_1).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # No referrer at all: URLs here carry device ids and member emails as
    # path segments (/auth/prekeys/{email}/{device_id}), which must not
    # leak to any third party a page might link out to.
    add_header Referrer-Policy "no-referrer" always;
    # The API surface has no use for any of these; the harness asks for
    # camera/microphone on its own origin, which this doesn't block.
    add_header Permissions-Policy "geolocation=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;

    # Every payload this API accepts fits comfortably under this; a body
    # over it is rejected by nginx before it's read into the app's memory.
    client_max_body_size 16k;

    # LiveKit's server-to-server admin API (RemoveParticipant, ListRooms,
    # ...). auth-service reaches it directly over the compose network as
    # LIVEKIT_INTERNAL_URL, so nothing legitimate calls it from outside.
    # LiveKit does authenticate these itself -- they need a JWT signed
    # with LIVEKIT_API_SECRET carrying roomAdmin/roomList grants, which
    # no room token this service mints ever has -- so this is defence in
    # depth rather than a hole being closed. Exposing an admin API to the
    # internet when the only caller is on the same bridge network is
    # surface with no upside.
    location /twirp/ {
        return 404;
    }

    # LiveKit signaling (WSS) — SFU handles the actual media, this is just
    # the signaling/control-plane WebSocket.
    location / {
        proxy_pass http://livekit:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    # Auth service (OTP login, room-token minting — §4)
    location /auth/ {
        limit_req zone=auth_zone burst=20 nodelay;
        proxy_pass http://auth-service:8080/;
        proxy_set_header Host $host;
        # app/routers/auth.py's per-IP OTP limiter reads this. nginx sets
        # it from the real peer address, overwriting anything the client
        # sent -- which is what makes it trustworthy there. Keep these
        # two in step: the app treats a missing header as "unknown" and
        # would bucket every caller together.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # §13 Phase 3/4 testing aid only -- not part of the real product surface
    # (Phase 5's actual web client is a separate thing entirely). Serving
    # from here rather than a standalone dev server means the harness's
    # own fetch() calls, and getUserMedia's secure-context requirement,
    # both work correctly without any same-origin/mixed-content gymnastics.
    location /harness/ {
        alias /usr/share/nginx/harness/;
        try_files $uri $uri/ =404;

        # nginx doesn't inherit add_header from the server block once a
        # location sets its own -- these are restated, not just the CSP
        # override, or HSTS/X-Frame-Options/etc. would silently vanish
        # for this one path.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), payment=(), usb=(), interest-cohort=()" always;
        # Loosened relative to the server-wide policy above, and ONLY
        # here: the harness loads livekit-client's UMD build and its
        # E2EE worker script from jsdelivr (index.html/key-provider.js),
        # and the frame-cryptor worker runs from a blob: URL constructed
        # from that fetched script (see key-provider.js's header comment
        # for why it's a blob: URL and not the CDN URL directly). None of
        # the actual API paths (/auth/, LiveKit signaling) serve HTML/JS,
        # so tightening this back down for them wouldn't do anything
        # meaningful -- the point is not loosening it for paths where it
        # would matter.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'" always;
    }
}
