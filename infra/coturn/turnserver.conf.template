# coturn — standalone TURN relay, deliberately separate from LiveKit's built-in
# TURN so that TURN-over-443 traffic can be SNI-demuxed at the nginx layer,
# independent of LiveKit's own signaling port (§2, §7.1).

listening-port=3478
tls-listening-port=5349
# ^ 5349 is what nginx's stream block forwards TURN/TLS traffic to internally.
#   Clients never talk to 5349 directly — they connect to 443 with SNI set to
#   ${TURN_HOSTNAME}, and nginx routes it here undecrypted.

realm=${TURN_REALM}
fingerprint

# Time-limited REST-API-style credentials instead of static user/pass — the
# auth service mints short-lived TURN credentials the same way it mints
# LiveKit room tokens (§4's short-lived-credential posture, §9).
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}

cert=/etc/letsencrypt/live/${TURN_HOSTNAME}/fullchain.pem
pkey=/etc/letsencrypt/live/${TURN_HOSTNAME}/privkey.pem

# Narrowed relay range (§8) — tune once real usage patterns are known.
min-port=49160
max-port=49200

no-cli
no-tlsv1
no-tlsv1_1
