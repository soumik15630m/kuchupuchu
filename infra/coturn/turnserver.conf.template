# coturn — standalone TURN relay, deliberately separate from LiveKit's built-in
# TURN so that TURN-over-443 traffic can be SNI-demuxed at the nginx layer,
# independent of LiveKit's own signaling port (§2, §7.1).

listening-port=3478
tls-listening-port=5349
# ^ 5349 is what nginx's stream block forwards TURN/TLS traffic to internally.
#   Clients never talk to 5349 directly — they connect to 443 with SNI set to
#   ${TURN_HOSTNAME}, and nginx routes it here undecrypted.

realm=${TURN_REALM}
fingerprint

# Time-limited REST-API-style credentials instead of static user/pass — the
# auth service mints short-lived TURN credentials the same way it mints
# LiveKit room tokens (§4's short-lived-credential posture, §9).
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}

cert=/etc/letsencrypt/live/${TURN_HOSTNAME}/fullchain.pem
pkey=/etc/letsencrypt/live/${TURN_HOSTNAME}/privkey.pem

# Narrowed relay range (§8) — tune once real usage patterns are known.
min-port=49160
max-port=49200

# Filled in by docker-entrypoint.sh. Without it coturn allocates the
# relay on whichever interface the client arrived on -- which is
# 127.0.0.1 behind nginx's demux, reachable by nothing.
{{TURN_RELAY_IP}}

# What clients are told the relay is at, when that differs from where
# it binds. Under Docker it always does: coturn binds a container
# address, clients reach it through the host's published ports.
# Format is external/internal. Omitted when TURN_EXTERNAL_IP is unset.
{{TURN_EXTERNAL_IP}}

# This box runs on the operator's own home LAN by design (§1a) -- without
# these, any authenticated TURN client can direct the relay at loopback,
# link-local, or the operator's private address space (router admin panel,
# IoT devices, file shares). Deny the reserved/private ranges outright;
# LAN peers never need to reach each other through a TURN relay anyway.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# allowed-peer-ip overrides the denials above. MUST be empty in
# production -- opening a private range turns the relay into a way to
# reach anything on the operator's LAN. Set only by
# docker-compose.testing.yml, because on a single host the SFU's own
# address falls inside a denied range.
{{TURN_ALLOWED_PEER_IPS}}

# denied-peer-ip above covers unicast private space, but multicast and
# broadcast destinations are a separate address class it doesn't touch --
# without this a relay can be pointed at 224.0.0.0/4 and used to fan
# traffic out across the operator's LAN.
no-multicast-peers

# Relaying is for WebRTC media, which is UDP. Permitting TCP relay turns
# this into a general-purpose TCP proxy for anyone holding valid (short-
# lived, but valid) credentials.
no-tcp-relay

# A TURN username here is scoped to one DEVICE, and one device on one
# call allocates far more than a handful: two peer connections, a
# relay candidate per component, and gather_continually re-allocating
# on every ICE restart. Measured 10-20 per connect. This was 12, which
# refused allocations and broke relaying with no error naming quota.
user-quota=60
total-quota=600

# Bounds how long a relay port can be parked on a credential that has
# since expired for every other purpose.
max-allocate-lifetime=600
stale-nonce=600

no-cli
# Default /var/run/turnserver.pid isn't writable by the unprivileged
# turnserver user this runs as (infra/coturn/Dockerfile) -- harmless as a
# warning (coturn starts fine either way, nothing reads this pidfile), but
# pointing it somewhere actually writable is one less line of noise in
# every container's logs.
pidfile=/tmp/turnserver.pid
no-tlsv1
no-tlsv1_1
