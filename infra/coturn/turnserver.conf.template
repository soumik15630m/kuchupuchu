# coturn — standalone TURN relay, deliberately separate from LiveKit's built-in
# TURN so that TURN-over-443 traffic can be SNI-demuxed at the nginx layer,
# independent of LiveKit's own signaling port (§2, §7.1).

listening-port=3478
tls-listening-port=5349
# ^ 5349 is what nginx's stream block forwards TURN/TLS traffic to internally.
#   Clients never talk to 5349 directly — they connect to 443 with SNI set to
#   ${TURN_HOSTNAME}, and nginx routes it here undecrypted.

realm=${TURN_REALM}
fingerprint

# Time-limited REST-API-style credentials instead of static user/pass — the
# auth service mints short-lived TURN credentials the same way it mints
# LiveKit room tokens (§4's short-lived-credential posture, §9).
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}

cert=/etc/letsencrypt/live/${TURN_HOSTNAME}/fullchain.pem
pkey=/etc/letsencrypt/live/${TURN_HOSTNAME}/privkey.pem

# Narrowed relay range (§8) — tune once real usage patterns are known.
min-port=49160
max-port=49200

# This box runs on the operator's own home LAN by design (§1a) -- without
# these, any authenticated TURN client can direct the relay at loopback,
# link-local, or the operator's private address space (router admin panel,
# IoT devices, file shares). Deny the reserved/private ranges outright;
# LAN peers never need to reach each other through a TURN relay anyway.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

no-cli
no-tlsv1
no-tlsv1_1
