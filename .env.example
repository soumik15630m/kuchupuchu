# ---- Domain / reachability (§1a open decision — pick one before Phase 1 is "done") ----
# Public hostname clients dial for the app itself: auth-service HTTP endpoints
# and LiveKit's WSS signaling (both proxied through nginx's TLS vhost on 443).
PUBLIC_HOSTNAME=app.yourdomain.example

# A SEPARATE hostname, reserved for TURN. nginx's stream-layer SNI demux
# (infra/nginx/nginx.conf.template) has exactly one job: route TLS
# ClientHellos whose SNI matches TURN_HOSTNAME, undecrypted, to coturn: --
# everything else (including PUBLIC_HOSTNAME itself) goes to the app.
# It MUST differ from PUBLIC_HOSTNAME, or the demux can't tell "this is TURN
# traffic" from "this is a client dialing the app/LiveKit signaling", and
# app/LiveKit traffic gets silently routed to coturn instead (coturn doesn't
# speak HTTP/WS, so it just resets the connection -- this is exactly the
# failure mode you'd see if the two were ever equal).
# Required even for local Docker, because ICE server entries must be
# hostnames, never bare IPs (§7.1 hard constraint).
TURN_HOSTNAME=turn-relay.yourdomain.example

# ---- LiveKit ----
# NOTE: auth-service refuses to start if JWT_SECRET, LIVEKIT_API_SECRET or
# TURN_SHARED_SECRET is still one of the placeholders below, is shorter
# than 32 characters, or is reused across the three (see
# app/session_tokens.py's validate_secrets). Generate each one separately:
#   openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret
LIVEKIT_URL=wss://${PUBLIC_HOSTNAME}
# true once §1a's reachability decision is made and this is actually
# port-forwarded/tunneled -- LiveKit then correctly advertises its real
# public IP as an ICE candidate. Set to false for same-machine local
# testing (nip.io, hosts-file entries): with it true locally, LiveKit
# STUN-discovers a "public" IP that usually isn't reachable back to your
# own browser, and every local call fails ICE negotiation even though
# signaling looks fine.
LIVEKIT_USE_EXTERNAL_IP=true
# Leave unset/commented for production. For local testing with
# LIVEKIT_USE_EXTERNAL_IP=false, also set this to 127.0.0.1 -- otherwise
# LiveKit advertises its Docker-internal bridge IP (172.x.x.x) instead,
# which is equally unreachable from a host-machine browser on Docker
# Desktop (Windows/Mac). docker-compose.yml already publishes LiveKit's
# ports straight through to the host on the same numbers, so 127.0.0.1
# is what your browser can actually reach.
#LIVEKIT_NODE_IP=127.0.0.1

# ---- coturn ----
# Shared secret for time-limited TURN credentials (REST API style), not a static user/pass.
TURN_SHARED_SECRET=change_me_to_a_long_random_secret
TURN_REALM=${TURN_HOSTNAME}

# ---- redis ----
# Backs LiveKit's own state (§2/§3) today; Phase 5's wake-service is
# planned to depend on this same instance for WS-liveness tracking (§8),
# so auth gets set up now rather than retrofitted once more depends on it.
REDIS_PASSWORD=change_me_to_a_long_random_secret

# ---- auth-service ----
AUTH_PORT=8080
# Signs session access/refresh JWTs. Independent from LIVEKIT_API_SECRET --
# generate with `openssl rand -hex 32`, same as the other secrets in this file.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
SQLITE_PATH=/data/app.db
# ≤10 known members total (§1) — seed the allowlist via migrations/002_seed_allowlist.sql
# or the ADMIN_SEED_EMAILS list below on first boot.
ADMIN_SEED_EMAILS=you@example.com,partner@example.com

# Grants cross-person "revoke a person" (§4) on top of the self-service
# revoke every allowlisted member already has. Must already be in
# ADMIN_SEED_EMAILS above -- see app/migrate.py:seed_admins. Leave empty
# if nobody needs to revoke someone else's devices.
ADMIN_EMAILS=

# OTP delivery — accepted external dependency (§9).
#
# REQUIRED, with no default. auth-service refuses to start unless this is
# explicitly "console" or "smtp" (app/mailer.py's validate_transport).
#
# "console" prints login codes to stdout and sends NO email -- they land in
# `docker compose logs`, so anyone who can read this process's logs can log
# in as any member. That is fine for local development and catastrophic in
# production, and it used to be the silent default when this var was unset.
# Choosing it is now deliberate.
OTP_TRANSPORT=console

# Origin the web client is served from, for the CORS allowlist
# (app/main.py). This is a PLACEHOLDER value ("app." + PUBLIC_HOSTNAME) --
# replace it with wherever the actual web client is deployed before this
# leaves local dev, or CORS will reject it.
WEB_CLIENT_ORIGIN=https://app.${PUBLIC_HOSTNAME}
# Real provider settings, used when OTP_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <no-reply@yourdomain.example>"

# ---- proxy trust ----
# app/routers/auth.py's per-IP OTP rate limit reads X-Real-IP, which nginx
# sets from the real peer address (overwriting whatever the client sent).
# Set this to false if auth-service is ever reachable WITHOUT that nginx in
# front of it -- there the header is just an attacker-supplied string, and
# an IP-keyed limit that trusts it is bypassed by varying one header.
TRUST_PROXY_HEADERS=true

# ---- local dev TLS certificates ----
# When true, `docker compose up` signs certs for the CURRENT
# PUBLIC_HOSTNAME/TURN_HOSTNAME before nginx and coturn start (the
# cert-init service). That removes the manual ./scripts/dev-mkcert-cert.sh
# step, and means changing either hostname -- which happens on its own
# whenever a nip.io-style name's embedded LAN IP changes -- no longer
# leaves you with certs for a name nothing is using.
#
# MUST be false for any deployment using real certificates. ./certs is
# also where acme.sh/Let's Encrypt certs live, and dev certs are trusted
# by exactly one machine. cert-init additionally refuses to overwrite any
# certificate its own CA didn't issue, but the switch is the real guard.
DEV_AUTO_CERTS=true

# Where the host's mkcert CA lives -- the output of `mkcert -CAROOT`.
# Mounted read-only into cert-init, which signs with it so the results are
# trusted by the same trust store the browser uses. Only read when
# DEV_AUTO_CERTS=true. Typical values:
#   Windows  C:/Users/<you>/AppData/Local/mkcert
#   macOS    /Users/<you>/Library/Application Support/mkcert
#   Linux    /home/<you>/.local/share/mkcert
MKCERT_CAROOT=
