# ---- Domain / reachability (§1a open decision — pick one before Phase 1 is "done") ----
# Public hostname clients dial for the app itself: auth-service HTTP endpoints
# and LiveKit's WSS signaling (both proxied through nginx's TLS vhost on 443).
PUBLIC_HOSTNAME=app.yourdomain.example

# A SEPARATE hostname, reserved for TURN. nginx's stream-layer SNI demux
# (infra/nginx/nginx.conf.template) has exactly one job: route TLS
# ClientHellos whose SNI matches TURN_HOSTNAME, undecrypted, to coturn: --
# everything else (including PUBLIC_HOSTNAME itself) goes to the app.
# It MUST differ from PUBLIC_HOSTNAME, or the demux can't tell "this is TURN
# traffic" from "this is a client dialing the app/LiveKit signaling", and
# app/LiveKit traffic gets silently routed to coturn instead (coturn doesn't
# speak HTTP/WS, so it just resets the connection -- this is exactly the
# failure mode you'd see if the two were ever equal).
# Required even for local Docker, because ICE server entries must be
# hostnames, never bare IPs (§7.1 hard constraint).
TURN_HOSTNAME=turn-relay.yourdomain.example

# ---- LiveKit ----
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret
LIVEKIT_URL=wss://${PUBLIC_HOSTNAME}

# ---- coturn ----
# Shared secret for time-limited TURN credentials (REST API style), not a static user/pass.
TURN_SHARED_SECRET=change_me_to_a_long_random_secret
TURN_REALM=${TURN_HOSTNAME}

# ---- auth-service ----
AUTH_PORT=8080
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
SQLITE_PATH=/data/app.db
# ≤10 known members total (§1) — seed the allowlist via migrations/002_seed_allowlist.sql
# or the ADMIN_SEED_EMAILS list below on first boot.
ADMIN_SEED_EMAILS=you@example.com,partner@example.com

# OTP delivery — accepted external dependency (§9). OTP_TRANSPORT=console for local dev
# (prints the code to the auth-service logs instead of sending real email).
OTP_TRANSPORT=console
# Real provider settings, used when OTP_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <no-reply@yourdomain.example>"
